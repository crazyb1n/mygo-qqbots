# ---- NoneBot ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["10001"]
BOT_NICKNAME=若叶睦
LOG_LEVEL=INFO

# ---- OneBot v11（NapCat 等实现的 WS 地址）----
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]

# ---- 白名单与触发 ----
# 逗号分隔的群号；例子里是占位符，改成你自己的群
ALLOWED_GROUPS=100000001,100000002
TRIGGER_KEYWORDS=若叶睦,睦
REPLY_RATE=0.0
MORTIS_TRIGGER_RATE=0.1

# ---- LLM ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_EFFORT=low
DISABLE_REASONING=0

# 可选：主备网关降级（留空则只用 DEEPSEEK_*）
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ---- 可选能力 ----
# 识图（OpenAI 兼容视觉端点）
VISION_BASE_URL=
VISION_MODEL=
# 联网搜索 / 语音 - 见 src/plugins 对应实现与 README
SEARCH_ENABLED=1
TTS_ENABLED=0
# 每日新闻（娱乐向，按需配置）
NEWS_GROUPS=
NEWS_FRIENDS=
NEWS_SCHEDULE=早报=08:00,晚报=21:00
