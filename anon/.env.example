# ---- NoneBot ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["10001"]
BOT_NICKNAME=千早爱音
BOT_QQ=200000003
LOG_LEVEL=INFO

# ---- OneBot v11（NapCat 等实现的 WS 地址）----
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3003"]

# ---- 白名单 ----
ALLOWED_GROUPS=100000001

# ---- LLM ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANON_CHAT_MODEL=
ANON_TASK_MODEL=
DEEPSEEK_REASONING_EFFORT=low
ANON_CHAT_REASONING_EFFORT=low
ANON_TASK_REASONING_EFFORT=high
DISABLE_REASONING=0
ANON_CHAT_MAX_TOKENS=2048
ANON_TASK_MAX_TOKENS=8192
ANON_CHAT_TIMEOUT=90
ANON_TASK_TIMEOUT=240

# 可选：主备网关降级
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ---- 熔断（短时间大量消耗自动停 LLM，进程不掉线）----
CIRCUIT_WINDOW_SECONDS=300
CIRCUIT_MAX_TOKENS=200000
CIRCUIT_BREAK_SECONDS=600

# ---- 滚动群摘要 ----
ANON_SUMMARY_ENABLED=1
ANON_SUMMARY_INTERVAL=30
ANON_SUMMARY_CHARS=400

# ---- 可选：识图 ----
ANON_VISION_ENABLED=0
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT=45
