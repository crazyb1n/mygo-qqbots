# ---- NoneBot ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["10001"]
BOT_NICKNAME=薇欧拉
BOT_QQ=200000002
LOG_LEVEL=INFO

# ---- OneBot v11（NapCat 等实现的 WS 地址）----
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3002"]

# ---- 白名单 ----
ALLOWED_GROUPS=100000001

# ---- LLM ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_EFFORT=low
DISABLE_REASONING=0

# ---- 行为参数 ----
REPLY_RATE=0.05
COOLDOWN_SECONDS=8
MAX_HISTORY_TURNS=20
SUMMARY_INTERVAL=30
DESIRE_PROACTIVE_FACTOR=1.0
DESIRE_PROACTIVE_CAP=1.0

# ---- 可选：独立任务网关 / 识图 ----
AGENT_ENABLED=0
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
HOMEWORK_MODEL=
VISION_BASE_URL=
VISION_MODEL=
